t. Remove a project to make room.';$('#personal').textContent=`Your best feasible score on this puzzle: ${fmt(store[key()]?.best||0)}`;}\\n function reveal(){const row=E.evaluate(p,mask),best=sol.bestMasks[0],target=E.evaluate(p,best),remove=p.projects.filter((v,j)=>(mask&(1<<j))&&!(best&(1<<j))).map(v=>v.name),add=p.projects.filter((v,j)=>!(mask&(1<<j))&&(best&(1<<j))).map(v=>v.name),won=row.valid&&row.score===sol.best;revealed=true;save(won?'optimum':'reveal');$('#answer').hidden=false;$('#answer').classList.toggle('celebrate',won);$('#answer').innerHTML=`<p class=\\\"eyebrow\\\">${won?'EXACT OPTIMUM FOUND':'THE EXACT REVEAL'}</p><h2>${won?'You found a best possible choice!':'A score of '+fmt(sol.best)+' is possible.'}</h2><p><strong>${fmt(sol.count)} portfolios fit.</strong> ${sol.bestMasks.length} ${sol.bestMasks.length===1?'choice achieves':'choices achieve'} the best score. ${row.valid?'Your score is '+fmt(row.score)+', '+fmt(sol.best-row.score)+' below the best.':'Your current group exceeds a budget or misses the required project.'}</p><p>${remove.length?'Leave out '+escape(remove.join(', '))+'. ':''}${add.length?'Add '+escape(add.join(', '))+'. ':''}${won?'Different optimal selections can use resources differently.':''}</p><p>The whole combination matters: the replacement projects fit all five budgets together. Exact total use: ${target.use.map((n,k)=>'R'+(k+1)+' '+n+'/'+p.resources[k].max).join(' \\u00b7 ')}.</p>${V.comparison(p,row,target)}<button id=\\\"use-best\\\">Try this best portfolio</button> <a href=\\\"/geometry/\\\">See the original 50-project milestone \\u2192</a>`;$('#use-best').onclick=()=>{mask=best;save('try-best');render();reveal();};$('#answer').scrollIntoView({block:'nearest'});}\\n function open(){p=E.problem(source,seed,mode);sol=E.solve(p);const shared=params.get('pick'),saved=store[key()]?.mask;mask=Number.isInteger(saved)&&saved>=0&&saved<4096?saved:0;if(shared!==null&&/^\\\\d{1,4}$/.test(shared)&&Number(shared)<4096)mask=Number(shared);params.delete('pick');if(p.required!==null)mask|=1;$('#mode').value=mode;$('#day').textContent=`Puzzle ${seed} \\u00b7 ${seed===today()?'daily puzzle, UTC':'reproducible replay'}`;$('#notice').textContent=mode==='keep'?'Keep the first project. Find the best group around it.':mode==='lean'?'Same projects, tighter budgets. Which choices still fit?':'Choose any group. Every card uses each of the five resources shown.';$('#hint-text').textContent='';$('#answer').hidden=true;save('start');render();const q=new URLSearchParams({seed,mode});history.replaceState(null,'',location.pathname+'?'+q);}\\n $('#mode').onchange=()=>{mode=$('#mode').value;open();};$('#daily').onclick=()=>{seed=today();open();};$('#clear').onclick=()=>{mask=p.required===null?0:1;save('restart');$('#answer').hidden=true;$('#hint-text').textContent='';render();};$('#reveal').onclick=reveal;\\n $('#hint').onclick=()=>{const target=sol.bestMasks[0],j=p.projects.findIndex((_,j)=>!!(mask&(1<<j))!==!!(target&(1<<j)));$('#hint-text').textContent=j<0?'You already have one optimal selection. Reveal the answer to confirm it.':`Try ${target&(1<<j)?'adding':'removing'} ${p.projects[j].name}. This is one move toward an exact best portfolio; you may need other changes to fit.`;save('hint');};\\n $('#share').onclick=async()=>{const url=new URL(location.href);url.search=new URLSearchParams({seed,mode,pick:String(mask)}).toString();const row=E.evaluate(p,mask),text=`My ${row.valid?'feasible ':''}score is ${row.score} on PerfectPower puzzle ${seed}. Can you find the best combination?`;$('#share-link').hidden=false;$('#share-link').value=url.href;try{if(navigator.share)await navigator.share({title:'Can you beat the optimizer?',text,url:url.href});else{await navigator.clipboard.writeText(text+' '+url.href);$('#share-status').textContent='Replay link copied. Your friend gets the same projects and choices.';}save('share');}catch{$('#share-status').textContent='Copy the replay link below to share the same challenge.';$('#