ground:#ffce8810;color:#dce9ef}\\n\\n.geometry-guide{display:flex;gap:10px;flex-wrap:wrap;margin:22px 0 12px}.geometry-guide button[aria-pressed=true]{background:#67dbc0;color:#0b1726;border-color:#67dbc0}.geometry-explanation{background:#203c4b;border-left:3px solid #67dbc0;padding:16px 20px;border-radius:8px;line-height:1.7;font-size:14px;margin-bottom:20px}.geometry-explanation strong{color:#fff}.geometry-advanced{margin:14px 0}.geometry-advanced summary,.geometry-scope summary{cursor:pointer;color:#b9ccd8;padding:8px 0}.geometry-inspector th:first-child{min-width:70px}@media(max-width:500px){.geometry-guide{display:grid;grid-template-columns:1fr}.geometry-guide button{text-align:left}.geometry-explanation{padding:14px}.geometry-inspector table{font-size:11px}}\\n\",\"shared/finite-counter.js\":\"/* Finite integer sum-product elimination, adapted from PerfectPower graph_counting.py.\\n * Exact arithmetic: every table entry is a nonnegative BigInt; probabilities are ratios.\\n * This browser implementation is tested against the retained Python source, not Lean-proved.\\n */\\n(function(root){'use strict';\\nfunction each(domains,scope,visit){const a=[];function step(i){if(i===scope.length){visit(a);return}for(const x of domains[scope[i]]){a[i]=x;step(i+1)}}step(0)}\\nfunction countFactors(spec){const domains=spec.domains;if(!Array.isArray(domains)||domains.some(d=>!d.length||new Set(d).size!==d.length))throw Error('Nonempty distinct domains required');let fs=spec.factors.map(f=>{let n=f.scope.reduce((p,i)=>p*domains[i].length,1);if(n!==f.values.length||new Set(f.scope).size!==f.scope.length)throw Error('Invalid factor');const t=new Map;let k=0;each(domains,f.scope,a=>{const w=BigInt(f.values[k++]);if(w<0n)throw Error('Negative weight');t.set(a.join(','),w)});return {scope:f.scope,table:t}});for(let v=0;v<domains.length;v++){const selected=fs.filter(f=>f.scope.includes(v));fs=fs.filter(f=>!f.scope.includes(v));const scope=[...new Set([v,...selected.flatMap(f=>f.scope)])].sort((a,b)=>a-b);if(scope.reduce((p,i)=>p*domains[i].length,1)>1000000)throw Error('Work budget exceeded');const boundary=scope.filter(i=>i!==v),out=new Map,loc=selected.map(f=>f.scope.map(i=>scope.indexOf(i))),ix=boundary.map(i=>scope.indexOf(i));each(domains,scope,a=>{let w=1n;selected.forEach((f,i)=>w*=f.table.get(loc[i].map(j=>a[j]).join(',')));const k=ix.map(j=>a[j]).join(',');out.set(k,(out.get(k)||0n)+w)});fs.push({scope:boundary,table:out})}return fs.reduce((p,f)=>p*f.table.get(''),1n)}\\nfunction countMasks(weights,masks){const d=weights.map((_,i)=>i);if(!d.length)return 0n;return countFactors({domains:[d],factors:[{scope:[0],values:weights},...masks.map(values=>({scope:[0],values}))]})}\\nconst api={countFactors,countMasks};root.PerfectPowerCounter=api;if(typeof module!=='undefined')module.exports=api;\\n})(typeof globalThis!=='undefined'?globalThis:this);\\n\",\"shared/live-apps.js\":\"/* Shared app navigation and live public research consumption. No private inputs are sent. */\\n(function(){'use strict';\\nconst base='https://raw.githubusercontent.com/towre676-cloud/perfectpower/main/data/';\\nconst product=document.currentScript?.dataset.product||'perfectpower';let known={},busy=false;\\nconst sha=async raw=>Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(raw))),x=>x.toString(16).padStart(2,'0')).join('');\\nfunction node(tag,text){const n=document.createElement(tag);if(text)n.textContent=text;return n;}\\nlet host=document.getElementById('our-apps-live');if(!host){host=node('section');host.id='our-apps-live';document.body.append(host);}\\nhost.style.cssText='margin:24px auto;padding:18px 22px;max-width:1120px;border:1px solid #9aafa744;border-radius:14px;font:13px/1.6 system-ui;background:#eef3ee;color:#244c43;';\\nconst top=node('div');top.style.cssText='display:flex;gap:18px;align-items:center;justify-content:space-between;flex-wrap:wrap';\\nconst title=node('strong','Your app collection'),status=node('span','Checking research updates\\u2026'),link=node('a','All apps & downloads \\u2192');link.href='https://our-apps.towre676.chatgpt.site';link.style.color='#28634d';top.append(title,link);host.append(top,status);\\nconst links=node('div');links.style.cssText='display:flex;gap:14px;flex-wrap:wrap;margin-top:10px';host.append(links);\\nconst detail=node('details'),summary=node('summary','What connects these apps?'),content=node('div');detail.append(summary,content);host.append(detail);\\nasync function envelope(url){const response=await fetch(url,{cache:'no-store'});if(!response.ok)throw Error('Research update unavailable');const e=await response.json();if(typeof e.payload_json!=='string'||await sha(e.payload_json)!==e.payload_sha256)throw Error('Research update did not match its digest');return {payload:JSON.parse(e.payload_json),digest:e.payload_sha256,source_parent:e.source_parent};}\\nasync function refresh(){if(busy)return;busy=true;try{\\n const response=await fetch(base+'app_ecosystem.json',{cache:'no-store'});if(!response.ok)throw Error('App index unavailable');const registry=await response.json();if(registry.schema!=='our-apps/1')throw Error('Unsupported app index');\\n links.replaceChildren();for(const p of registry.products){const a=node('a',p.name);a.href=p.open;a.style.color='#28634d';links.append(a);}\\n const current=registry.products.find(p=>p.id===product)||registry.products[0];content.replaceChildren();for(const p of registry.products){const para=node('p');para.append(node('strong',p.name+' \\u2014 '),document.createTextNode(p.purpose+'. '+p.how));content.append(para);}\\n const updates={};for(const source of current.sources){try{updates[source]=await envelope(registry.upstreams[source].feed);}catch(error){updates[source]={unavailable:true};}}\\n const changed=Object.entries(updates).some(([key,value])=>known[key]&&value.digest&&known[key]!==value.digest);\\n const ready=Object.values(updates).filter(x=>x.digest).length;\\n status.textContent=ready===current.sources.length?(changed?'New research is ready \\u00b7 refreshed from the source':'Connected to published research'):'Some sources are offline \\u00b7 saved app content stays available';\\n for(const [key,value] of Object.entries(updates))if(value.digest)known[key]=value.digest;\\n if(product==='nfl'||product==='perfectpower'){\\n  try{const r=await fetch('https://raw.githubusercontent.com/towre676-cloud/perfectpower/main/web/shared/finite-counter.js',{cache:'no-store'});if(!r.ok)throw Error('Counter unavailable');const source=await r.text();const counter={source,sha256:await sha(source)};\\n   if(globalThis.__ourCounterSHA!==counter.sha256){\\n    const script=document.createElement('script'),url=URL.createObjectURL(new Blob([counter.source],{type:'application/javascript'}));\\n    await new Promise((resolve,reject)=>{script.onload=resolve;script.onerror=reject;script.src=url;document.head.append(script);});URL.revokeObjectURL(url);script.remove();\\n    if(typeof globalThis.PerfectPowerCounter?.countFactors!=='function'||typeof globalThis.PerfectPowerCounter?.countMasks!=='function')throw Error('Counter API unavailable');\\n    globalThis.__ourCounterSHA=counter.sha256;window.dispatchEvent(new CustomEvent('ecosystem:engine-updated',{detail:{product,sha256:counter.sha256}}));\\n   }\\n  }catch(error){status.textContent+=' \\u00b7 using the installed counting engine';}\\n }\\n globalThis.OurApps={registry,updates,refresh};window.dispatchEvent(new CustomEvent('ecosystem:update',{detail:{registry,updates,product,changed}}));\\n}catch(error){status.textContent='Offline \\u00b7 your app and saved work are still available';}finally{busy=false;}}\\nrefresh();setInterval(refresh,300000);window.addEventListener('online',refresh);\\n})();\\n\",\"shared/live-loader.js\":\"(async()=>{const product=document.currentScript.dataset.product;let source;try{const r=await fetch('https://raw.githubusercontent.com/towre676-cloud/perfectpower/main/web/shared/live-apps.js',{cache:'no-store'});if(!r.ok)throw Error();source=await r.text();if(!source.startsWith('/* Shared app navigation'))throw Error();}catch{}const s=document.createElement('script');s.dataset.product=product;if(source){const url=URL.createObjectURL(new Blob([source],{type:'application/javascript'}));s.src=url;s.onload=()=>URL.revokeObjectURL(url);}else s.src='/live-apps.js';document.body.append(s);})();\",\"simple-explorer/app.js\":\"const items=[['Water',2],['Snack',3],['Book',4],['Camera',7],['Blanket',5],['Game',6]];let result;const $=s=>document.querySelector(s);for(const [name,cost]of items){const n=document.createElement('span');n.textContent=name+' \\u00b7 '+cost;$('#items').append(n);}$('#budget').oninput=()=>$('#budget-value').textContent=$('#budget').value;function calculate(){const budget=Number($('#budget').value),required=$('#required').checked,rows=[],mask=[];for(let m=0;m<64;m++){const selected=items.filter((_,i)=>m&(1<<i)),cost=selected.reduce((s,x)=>s+x[1],0),valid=cost<=budget&&(!required||(m&1));mask.push(valid?1:0);if(valid)rows.push({items:selected.map(x=>x[0]),cost});}const count=PerfectPowerCounter.countMasks(Array(64).fill(1),[mask]);if(count!==BigInt(rows.length))throw Error('Independent enumeration mismatch');result={budget,water_required:required,count:String(count),combinations:rows,counter_sha256:globalThis.__ourCounterSHA||'bundled',scope:'All subsets of these six displayed items'};$('#answer').textContent=count+' combinations fit';$('#explain').textContent='Every valid combination is listed below. The empty bag counts when water is optional.';$('#combinations').replaceChildren();for(const row of rows){const n=document.createElement('p');n.textContent=(row.items.join(', ')||'Empty bag')+' \\u00b7 '+row.cost+' units';$('#combinations').append(n);}$('#save').disabled=false;}$('#calculate').onclick=calculate;window.addEventListener('ecosystem:engine-updated',()=>{if(result)calculate();});$('#save').onclick=()=>{const a=document.createElement('a'),url=URL.createObjectURL(new Blob([JSON.stringify(result,null,2)],{type:'application/json'}));a.href=url;a.download='PerfectPower-Possibilities.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);};\",\"simple-explorer/index.html\":\"<!doctype html><html lang=\\\"en\\\"><meta charset=\\\"utf-8\\\"><meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\"><title>PerfectPower \\u00b7 Explore possibilities</title><link rel=\\\"stylesheet\\\" href=\\\"/start/style.css\\\"><body><header><strong>PerfectPower</strong><a href=\\\"https://our-apps.towre676.chatgpt.site\\\">All apps & downloads</a></header><main><p class=\\\"eyebrow\\\">EXPLORE EXACT POSSIBILITIES</p><h1>What fits your rules?</h1><p>Choose a spending limit. Find every combination that fits, without guessing or sampling.</p><section class=\\\"panel\\\"><h2>Pack a day out</h2><p>Each item is optional. A combination includes each chosen item once.</p><label>Your budget <output id=\\\"budget-value\\\">12</output> units<input id=\\\"budget\\\" type=\\\"range\\\" min=\\\"0\\\" max=\\\"30\\\" value=\\\"12\\\"></label><div id=\\\"items\\\"></div><label><input id=\\\"required\\\" type=\\\"checkbox\\\"> Every combination must include water</label><button id=\\\"calculate\\\">Show all possibilities \\u2192</button></section><section class=\\\"panel\\\" aria-live=\\\"polite\\\"><h2 id=\\\"answer\\\">Your possibilities</h2><p id=\\\"explain\\\">Set your rules, then calculate.</p><div id=\\\"combinations\\\"></div><button id=\\\"save\\\" disabled>Download the exact result</button></section><section><h2>Which question are you asking?</h2><p>PerfectPower counts complete finite possibilities. DynaComp follows how a system changes and compares a smaller model with the original. NFL PerfectPower explains games and prices. Pokepolis is for playing and exploring a game world.</p><p><a href=\\\"/research\\\">More mathematical questions</a> \\u00b7 <a href=\\\"/\\\">PerfectPower downloads</a></p></sectio