theorem elliptic_finite_density (x y : ℝ) (hx0 : (2 : ℝ) ≤ x) (hx1 : x ≤ (3 : ℝ))
    (hy0 : (0 : ℝ) ≤ y) (hy1 : y ≤ ((1 : ℝ)/4)) :
    ((1 : ℝ)/6)^2*(1 : ℝ) < ((1 : ℝ))/Real.sqrt ((1 : ℝ)*(y)^2 + (2 : ℝ)*(y)^4 + (1 : ℝ)*(y)^6 + (1 : ℝ)*(x)^2 + (3 : ℝ)*(x)^2*(y)^4 + (-2 : ℝ)*(x)^4 + (3 : ℝ)*(x)^4*(y)^2 + (1 : ℝ)*(x)^6) ∧
      ((1 : ℝ))/Real.sqrt ((1 : ℝ)*(y)^2 + (2 : ℝ)*(y)^4 + (1 : ℝ)*(y)^6 + (1 : ℝ)*(x)^2 + (3 : ℝ)*(x)^2*(y)^4 + (-2 : ℝ)*(x)^4 + (3 : ℝ)*(x)^4*(y)^2 + (1 : ℝ)*(x)^6) < ((1 : ℝ)/2)^2*(1 : ℝ) := by
  apply density_comparison ((1 : ℝ)) ((1 : ℝ)*(y)^2 + (2 : ℝ)*(y)^4 + (1 : ℝ)*(y)^6 + (1 : ℝ)*(x)^2 + (3 : ℝ)*(x)^2*(y)^4 + (-2 : ℝ)*(x)^4 + (3 : ℝ)*(x)^4*(y)^2 + (1 : ℝ)*(x)^6) (1 : ℝ) ((1 : ℝ)/6) ((1 : ℝ)/2)
    (elliptic_finite_numerator_positive x y hx0 hx1 hy0 hy1)
    (elliptic_finite_denominator_positive x y hx0 hx1 hy0 hy1) (by norm_num) (by norm_num) (by norm_num)
  · convert elliptic_finite_lower_gap x y hx0 hx1 hy0 hy1 using 1 <;> ring
  · convert elliptic_finite_upper_gap x y hx0 hx1 hy0 hy1 using 1 <;> ring

