namespace PerfectPower.MetricBoxExamples
open PerfectPower.BernsteinBoxes
theorem elliptic_finite_numerator_positive_node_0 (x y : ℝ) (hx0 : (2 : ℝ) ≤ x) (hx1 : x ≤ (3 : ℝ))
    (hy0 : (0 : ℝ) ≤ y) (hy1 : y ≤ ((1 : ℝ)/4)) : 0 < ((1 : ℝ)) := by
  let coeff : Fin 1 → Fin 1 → ℚ := ![![(1 : ℚ)]]
  have hc : ∀ i j, 0 < coeff i j := by
    decide +kernel
  have hid : ∀ s t : ℝ,
      (fun x y : ℝ => ((1 : ℝ))) ((2 : ℝ)+((1 : ℝ))*s)
        ((0 : ℝ)+(((1 : ℝ)/4))*t) = tensor 0 0 coeff s t := by
    intro s t
    norm_num [tensor,basis,coeff,Fin.sum_univ_succ] <;> ring
  exact rectangle_positive (fun x y : ℝ => ((1 : ℝ)))
    (2 : ℝ) (3 : ℝ) (0 : ℝ) ((1 : ℝ)/4) (by norm_num) (by norm_num)
    0 0 coeff hc (by intro s t; convert hid s t using 1 <;> ring) x y hx0 hx1 hy0 hy1

abbrev elliptic_finite_numerator_positive := elliptic_finite_numerator_positive_node_0

