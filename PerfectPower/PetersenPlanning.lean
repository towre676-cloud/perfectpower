def highPrefix : List Bool := [true, true, true, true, true, true, true, true, true, true, true, true, true, true, true, false, true, true, true, true, false, true, false, true, true, true]

def residualCaps : List Nat := rows.zipWith (fun row cap => cap-dot (row.take highPrefix.length) highPrefix) capacities

def guardRow : List Nat := suffixRows[3]!

theorem residual_capacities : residualCaps = [327,213,91,4,181] := by decide

theorem high_prefix_bounds : ∀ row cap, (row,cap) ∈ rows.zip capacities → dot (row.take highPrefix.length) highPrefix ≤ cap := by
  have h : (rows.zip capacities).all (fun pair => decide (dot (pair.1.take highPrefix.length) highPrefix ≤ pair.2)) = true := by decide
  intro row cap hm
  exact of_decide_eq_true (List.all_eq_true.mp h (row,cap) hm)

theorem high_prefix_original_semantics (xs : List Bool) :
    feasible rows capacities (highPrefix++xs) = feasible suffixRows residualCaps xs := by
  exact feasible_prefix rows capacities highPrefix xs (by decide) high_prefix_bounds

theorem high_guard_bounds : ∀ row cap, (row,cap) ∈ suffixRows.zip residualCaps →
    (row = guardRow ∧ cap = 4) ∨ (row.length = guardRow.length ∧ allowedTotal row guardRow 4 ≤ cap) := by
  have h : (suffixRows.zip residualCaps).all (fun pair => decide ((pair.1 = guardRow ∧ pair.2 = 4) ∨ (pair.1.length = guardRow.length ∧ allowedTotal pair.1 guardRow 4 ≤ pair.2))) = true := by decide
  intro row cap hm
  exact of_decide_eq_true (List.all_eq_true.mp h (row,cap) hm)

theorem high_guard_semantics (xs : List Bool) :
    feasible suffixRows residualCaps xs = decide (dot guardRow xs ≤ 4) := by
  have eq : (feasible suffixRows residualCaps xs = true) ↔ dot guardRow xs ≤ 4 := by
    constructor
    · intro h
      exact feasible_member_bound suffixRows residualCaps xs guardRow 4 (by decide) h
    · intro h
      exact guard_implies_feasible suffixRows residualCaps guardRow 4 xs (by decide) high_guard_bounds h
  cases hf : feasible suffixRows residualCaps xs
  · have h : ¬ dot guardRow xs ≤ 4 := by intro h; have := eq.mpr h; simp [hf] at this
    simp [h]
  · have h := eq.mp hf
    simp [h]

theorem high_guard_diagram_population : weight (threshold guardRow 4) 24 = 512 := by decide

theorem high_prefix_original_population :
    census 24 (fun xs => feasible rows capacities (highPrefix++xs)) = 512 := by
  rw [census_congr 24 _ _ high_prefix_original_semantics, census_congr 24 _ _ high_guard_semantics]
  have h := threshold_count guardRow 4
  have hl : guardRow.length = 24 := by decide
  rw [hl] at h
  rw [← h]
  exact high_guard_diagram_population

