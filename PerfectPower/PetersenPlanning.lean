def capacities : List Nat := [800, 650, 550, 550, 650]

def suffixRows : List (List Nat) := rows.map (fun row => row.drop 26)

theorem original_dimensions : rows.length = 5 ∧ (∀ row ∈ rows, row.length = 50) := by decide

theorem suffix_totals : suffixRows.map List.sum = [449, 347, 252, 200, 192] := by decide

theorem suffix_bounds : ∀ row cap, (row,cap) ∈ suffixRows.zip capacities → row.sum ≤ cap := by
  have h : (suffixRows.zip capacities).all (fun pair => decide (pair.1.sum ≤ pair.2)) = true := by decide
  intro row cap hm
  exact of_decide_eq_true (List.all_eq_true.mp h (row,cap) hm)

theorem zero_prefix_suffix_population : census 24 (feasible suffixRows capacities) = 16777216 := by
  exact unconstrained_population 24 suffixRows capacities suffix_bounds (by decide)

theorem zero_prefix_original_semantics (xs : List Bool) :
    feasible rows capacities (List.replicate 26 false ++ xs) = feasible suffixRows capacities xs := by
  simp only [rows, capacities, suffixRows, List.map_cons, List.map_nil, feasible, dot_zero_prefix]

theorem zero_prefix_original_population :
    census 24 (fun xs => feasible rows capacities (List.replicate 26 false ++ xs)) = 16777216 := by
  rw [census_congr 24 _ _ zero_prefix_original_semantics]
  exact zero_prefix_suffix_population

