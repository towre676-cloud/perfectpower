def cs_15 : List ((ℤ × ℤ × ℤ × ℤ) × List (ℤ × ℤ)) := [(((-1), (-1), 0, (-6)), [((-7), 2), ((-1), 0)]), ((0, (-1), 0, (-15)), [])]

/-- **Irreducible source 0** (several solutions): `RankOneZeros.K15.source0` at `u + 1v`. -/
theorem sols_zirr0 : SolsIn ((-1), (-1), 0, (-6)) [((-7), 2), ((-1), 0)] := by
  intro u v h
  have h' : -(u + 1 * v) ^ 3 + 3 * (u + 1 * v) * v ^ 2 + (-8) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  have hm := (Generated.RankOneZeros.K15.source0 (u + 1 * v) v).mp h'
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hm
  rcases hm with ⟨h1, rfl⟩ | ⟨h1, rfl⟩
  · obtain rfl : u = (-7) := by linarith
    simp
  · obtain rfl : u = (-1) := by linarith
    simp

theorem sols_15 : ∀ c ∈ cs_15, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_15, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl
  exacts [sols_zirr0, solsIn_of_loc (m := 3) (by norm_num) (by decide +kernel)]

