/-- **Irreducible source 0**: `RankOneSources.K48.source0` at `u + 0v`. -/
theorem sols_irr0 : SolsIn ((-1), 0, 1, (-14)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 0 * v) ^ 3 + 3 * (u + 0 * v) * v ^ 2 + (-14) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K48.source0 (u + 0 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

theorem sols_48 : ∀ c ∈ cs_48, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_48, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl
  exacts [solsIn_of_loc (m := 2) (by norm_num) (by decide +kernel), sols_irr0, solsIn_of_loc (m := 2) (by norm_num) (by decide +kernel), solsIn_of_loc (m := 3) (by norm_num) (by decide +kernel)]

