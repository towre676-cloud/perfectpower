/-- **The empty nonmonic source**: `RankOneNorm.K11.empty`. -/
theorem sols_empty : SolsIn ((-2), 0, (-1), (-3)) [] := by
  intro u v h
  exfalso
  exact Generated.RankOneNorm.K11.empty u v (by simp only [ev] at h; linear_combination h)

theorem sols_11 : ∀ c ∈ cs_11, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_11, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl
  exacts [sols_empty, solsIn_of_loc (m := 7) (by norm_num) (by decide +kernel)]

