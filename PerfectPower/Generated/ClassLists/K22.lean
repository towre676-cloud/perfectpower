/-- **Irreducible source 0**: `RankOneSources.K22.source0` at `u + 2v`. -/
theorem sols_irr0 : SolsIn ((-1), (-2), (-1), (-4)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 2 * v) ^ 3 + 9 * (u + 2 * v) * v ^ 2 + (-14) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K22.source0 (u + 2 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

theorem sols_22 : ∀ c ∈ cs_22, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_22, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl
  exacts [sols_irr0, solsIn_of_loc (m := 9) (by norm_num) (by decide +kernel)]

