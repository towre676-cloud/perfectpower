/-!
# `y² = x³ + 49` through irreducible rank-one sources, with no premise
(generated by `python/class_list_cert.py rank1`)

The classes for `k = 49` (`positive_k.json`):
* `(-4, -6, -3, -4)` is impossible modulo 7.
* `(-2, -3, -6, 4)` is impossible modulo 9.
* `(-2, 0, 0, -7)` is impossible modulo 7.
* `(-1, 0, 0, -14)` is irreducible: `F(u, v) = −N((u + 0v) − vz)` in `ℤ[z]`, `z³ = (0) z + (-14)`. Its only solution `(−1, 0)` comes from `RankOneSources.K49.source0` (unit generation and the Skolem zero set).
* `(0, -3, 0, -49)` is impossible modulo 9.

The class-list premise is proved by `ClassListProof.classList_of` (parameters by `norm_num`,
transports by the kernel), and `PositiveKCurve.complete_of_sols` reads off the points.
-/

set_option Elab.async false

namespace PerfectPower.Generated.ClassLists.K49

open PerfectPower MordellCubicForm ClassListProof PositiveKCurve ReducibleThue

/-- The 5 classes for `k = 49` with their solution lists. -/
def cs_49 : List ((ℤ × ℤ × ℤ × ℤ) × List (ℤ × ℤ)) := [(((-4), (-2), (-1), (-4)), []), (((-2), (-1), (-2), 4), []), (((-2), 0, 0, (-7)), []), (((-1), 0, 0, (-14)), [((-1), 0)]), ((0, (-1), 0, (-49)), [])]

/-- **Irreducible source 0**: `RankOneSources.K49.source0` at `u + 0v`. -/
theorem sols_irr0 : SolsIn ((-1), 0, 0, (-14)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 0 * v) ^ 3 + 0 * (u + 0 * v) * v ^ 2 + (-14) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K49.source0 (u + 0 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

theorem sols_49 : ∀ c ∈ cs_49, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_49, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl
  exacts [solsIn_of_loc (m := 7) (by norm_num) (by decide +kernel), solsIn_of_loc (m := 9) (by norm_num) (by decide +kernel), solsIn_of_loc (m := 7) (by norm_num) (by decide +kernel), sols_irr0, solsIn_of_loc (m := 9) (by norm_num) (by decide +kernel)]

