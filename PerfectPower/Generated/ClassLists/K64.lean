def cs_64 : List ((ℤ × ℤ × ℤ × ℤ) × List (ℤ × ℤ)) := [(((-4), 0, 0, (-4)), []), (((-3), (-1), (-3), (-1)), [(0, (-1))]), (((-2), 0, 0, (-8)), []), (((-1), 0, (-4), 0), redSols ⟨1, 0, (-1), 0, (-12), 1, 0⟩), (((-1), 0, 0, (-16)), [((-1), 0)]), ((0, (-2), 0, (-8)), []), ((0, (-1), 0, (-64)), redSols ⟨0, 1, (-3), 0, (-64), 0, 1⟩)]

/-- **Irreducible source 1** (witness normalization): `RankOneSources.K64.source1` at `U⁻¹(x, y)`. -/
theorem sols_irr1 : SolsIn ((-3), (-1), (-3), (-1)) [(0, (-1))] := by
  intro x y h
  have h' : -(3 * x - (-1) * y) ^ 3 + 24 * (3 * x - (-1) * y) * ((-1) * x + 0 * y) ^ 2 + 48 * ((-1) * x + 0 * y) ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, h2⟩ := (Generated.RankOneSources.K64.source1 _ _).mp h'
  obtain rfl : x = 0 := by linear_combination 0 * h1 + (-1) * h2
  obtain rfl : y = (-1) := by linear_combination 1 * h1 + 3 * h2
  simp

/-- **Irreducible source 0**: `RankOneSources.K64.source0` at `u + 0v`. -/
theorem sols_irr0 : SolsIn ((-1), 0, 0, (-16)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 0 * v) ^ 3 + 0 * (u + 0 * v) * v ^ 2 + (-16) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K64.source0 (u + 0 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

theorem sols_64 : ∀ c ∈ cs_64, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_64, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  exacts [solsIn_of_loc (m := 2) (by norm_num) (by decide +kernel), sols_irr1, solsIn_of_loc (m := 2) (by norm_num) (by decide +kernel), solsIn_of_red (c := ⟨1, 0, (-1), 0, (-12), 1, 0⟩) (by decide +kernel), sols_irr0, solsIn_of_loc (m := 2) (by norm_num) (by decide +kernel), solsIn_of_red (c := ⟨0, 1, (-3), 0, (-64), 0, 1⟩) (by decide +kernel)]

