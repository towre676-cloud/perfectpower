/-!
# `y² = x³ + 12` through irreducible rank-one sources, with no premise
(generated by `python/class_list_cert.py rank1`)

The classes for `k = 12` (`positive_k.json`):
* `(-3, -6, -6, 0)` is impossible modulo 3.
* `(-2, -3, 0, -3)` is irreducible and nonmonic. Its recorded point `(-2, 1)` gives `U = (2 -7; -1 4)`, `det U = 1`, with `F ∘ U = −u³ + (39) u v² + (-94) v³` (witness normalization); `RankOneSources.K12.source1` proves that form has only `(−1, 0)`, so `F` has only `(-2, 1)`.
* `(-1, 0, -6, -4)` is irreducible: `F(u, v) = −N((u + 0v) − vz)` in `ℤ[z]`, `z³ = (-6) z + (-4)`. Its only solution `(−1, 0)` comes from `RankOneSources.K12.source0` (unit generation and the Skolem zero set).
* `(0, -3, 0, -12)` is impossible modulo 3.

The class-list premise is proved by `ClassListProof.classList_of` (parameters by `norm_num`,
transports by the kernel), and `PositiveKCurve.complete_of_sols` reads off the points.
-/

set_option Elab.async false

namespace PerfectPower.Generated.ClassLists.K12

open PerfectPower MordellCubicForm ClassListProof PositiveKCurve ReducibleThue

/-- The 4 classes for `k = 12` with their solution lists. -/
def cs_12 : List ((ℤ × ℤ × ℤ × ℤ) × List (ℤ × ℤ)) := [(((-3), (-2), (-2), 0), []), (((-2), (-1), 0, (-3)), [((-2), 1)]), (((-1), 0, (-2), (-4)), [((-1), 0)]), ((0, (-1), 0, (-12)), [])]

/-- **Irreducible source 1** (witness normalization): `RankOneSources.K12.source1` at `U⁻¹(x, y)`. -/
theorem sols_irr1 : SolsIn ((-2), (-1), 0, (-3)) [((-2), 1)] := by
  intro x y h
  have h' : -(4 * x - (-7) * y) ^ 3 + 39 * (4 * x - (-7) * y) * (1 * x + 2 * y) ^ 2 + (-94) * (1 * x + 2 * y) ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, h2⟩ := (Generated.RankOneSources.K12.source1 _ _).mp h'
  obtain rfl : x = (-2) := by linear_combination 2 * h1 + (-7) * h2
  obtain rfl : y = 1 := by linear_combination (-1) * h1 + 4 * h2
  simp

/-- **Irreducible source 0**: `RankOneSources.K12.source0` at `u + 0v`. -/
theorem sols_irr0 : SolsIn ((-1), 0, (-2), (-4)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 0 * v) ^ 3 + (-6) * (u + 0 * v) * v ^ 2 + (-4) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K12.source0 (u + 0 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

theorem sols_12 : ∀ c ∈ cs_12, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_12, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl
  exacts [solsIn_of_loc (m := 3) (by norm_num) (by decide +kernel), sols_irr1, sols_irr0, solsIn_of_loc (m := 3) (by norm_num) (by decide +kernel)]

