/-- **Irreducible source 0** (several solutions): `RankOneZeros.K24.source0` at `u + 0v`. -/
theorem sols_zirr0 : SolsIn ((-1), 0, (-2), (-8)) [((-1), 0), (1, (-1)), (31, (-28))] := by
  intro u v h
  have h' : -(u + 0 * v) ^ 3 + (-6) * (u + 0 * v) * v ^ 2 + (-8) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  have hm := (Generated.RankOneZeros.K24.source0 (u + 0 * v) v).mp h'
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hm
  rcases hm with ⟨h1, rfl⟩ | ⟨h1, rfl⟩ | ⟨h1, rfl⟩
  · obtain rfl : u = (-1) := by linarith
    simp
  · obtain rfl : u = 1 := by linarith
    simp
  · obtain rfl : u = 31 := by linarith
    simp

/-- **Irreducible source 0**: `RankOneSources.K24.source0` at `u + 1v`. -/
theorem sols_irr0 : SolsIn ((-1), (-1), 0, (-8)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 1 * v) ^ 3 + 3 * (u + 1 * v) * v ^ 2 + (-10) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K24.source0 (u + 1 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

theorem sols_24 : ∀ c ∈ cs_24, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_24, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl
  exacts [sols_irr0, sols_zirr0, solsIn_of_loc (m := 3) (by norm_num) (by decide +kernel), solsIn_of_loc (m := 3) (by norm_num) (by decide +kernel)]

