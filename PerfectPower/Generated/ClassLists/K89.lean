/-- **Irreducible source 2** (witness normalization): `RankOneSources.K89.source2` at `U⁻¹(x, y)`. -/
theorem sols_irr2 : SolsIn ((-3), (-1), (-3), 1) [(0, 1)] := by
  intro x y h
  have h' : -(3 * x - 1 * y) ^ 3 + 30 * (3 * x - 1 * y) * (1 * x + 0 * y) ^ 2 + (-66) * (1 * x + 0 * y) ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, h2⟩ := (Generated.RankOneSources.K89.source2 _ _).mp h'
  obtain rfl : x = 0 := by linear_combination 0 * h1 + 1 * h2
  obtain rfl : y = 1 := by linear_combination (-1) * h1 + 3 * h2
  simp

/-- **Irreducible source 3** (witness normalization): `RankOneSources.K89.source3` at `U⁻¹(x, y)`. -/
theorem sols_irr3 : SolsIn ((-3), (-1), (-2), 4) [((-1), (-2))] := by
  intro x y h
  have h' : -(15 * x - 7 * y) ^ 3 + 165 * (15 * x - 7 * y) * ((-2) * x + 1 * y) ^ 2 + 816 * ((-2) * x + 1 * y) ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, h2⟩ := (Generated.RankOneSources.K89.source3 _ _).mp h'
  obtain rfl : x = (-1) := by linear_combination 1 * h1 + 7 * h2
  obtain rfl : y = (-2) := by linear_combination 2 * h1 + 15 * h2
  simp

/-- **Irreducible source 0**: `RankOneSources.K89.source0` at `u + 0v`. -/
theorem sols_irr0 : SolsIn ((-1), 0, (-4), (-10)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 0 * v) ^ 3 + (-12) * (u + 0 * v) * v ^ 2 + (-10) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K89.source0 (u + 0 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

/-- **Irreducible source 1**: `RankOneSources.K89.source1` at `u + 0v`. -/
theorem sols_irr1 : SolsIn ((-1), 0, (-2), (-18)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 0 * v) ^ 3 + (-6) * (u + 0 * v) * v ^ 2 + (-18) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K89.source1 (u + 0 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

theorem sols_89 : ∀ c ∈ cs_89, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_89, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl
  exacts [sols_irr2, sols_irr3, sols_irr0, sols_irr1, solsIn_of_red (c := ⟨0, 1, (-3), 0, (-89), 0, 1⟩) (by decide +kernel)]

