/-- **Irreducible source 0**: `RankOneSources.K3.source0` at `u + 1v`. -/
theorem sols_irr0 : SolsIn ((-1), (-1), 0, (-2)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 1 * v) ^ 3 + 3 * (u + 1 * v) * v ^ 2 + (-4) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K3.source0 (u + 1 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

theorem sols_3 : ∀ c ∈ cs_3, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_3, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl
  exacts [sols_irr0, solsIn_of_loc (m := 3) (by norm_num) (by decide +kernel)]

