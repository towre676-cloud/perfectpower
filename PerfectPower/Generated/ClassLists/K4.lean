/-- The 3 classes for `k = 4` with their solution lists. -/
def cs_4 : List ((ℤ × ℤ × ℤ × ℤ) × List (ℤ × ℤ)) := [(((-2), 0, 0, (-2)), []), (((-1), 0, 0, (-4)), [((-1), 0)]), ((0, (-1), 0, (-4)), [])]

/-- **The irreducible source**: `RankOneSources.source4`. -/
theorem sols_irr : SolsIn ((-1), 0, 0, (-4)) [((-1), 0)] := by
  intro u v h
  have h' : -u ^ 3 + 0 * u * v ^ 2 + (-4) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨rfl, rfl⟩ := (Generated.RankOneSources.source4 u v).mp h'
  simp

theorem sols_4 : ∀ c ∈ cs_4, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_4, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl
  exacts [solsIn_of_loc (m := 2) (by norm_num) (by decide +kernel), sols_irr, solsIn_of_loc (m := 7) (by norm_num) (by decide +kernel)]

