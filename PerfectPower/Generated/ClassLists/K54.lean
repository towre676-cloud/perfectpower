/-- **Irreducible source 0**: `RankOneSources.K54.source0` at `u + 1v`. -/
theorem sols_irr0 : SolsIn ((-1), (-1), 2, (-10)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 1 * v) ^ 3 + 9 * (u + 1 * v) * v ^ 2 + (-18) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K54.source0 (u + 1 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

theorem sols_54 : ∀ c ∈ cs_54, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_54, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl
  exacts [solsIn_of_loc (m := 3) (by norm_num) (by decide +kernel), solsIn_of_loc (m := 9) (by norm_num) (by decide +kernel), sols_irr0, solsIn_of_loc (m := 3) (by norm_num) (by decide +kernel)]

