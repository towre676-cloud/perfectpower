/-- **Irreducible source 0** (several solutions): `RankOneZeros.K17.source0` at `u + 1v`. -/
theorem sols_zirr0 : SolsIn ((-1), (-1), 1, (-5)) [((-1), 0), (4, (-1))] := by
  intro u v h
  have h' : -(u + 1 * v) ^ 3 + 6 * (u + 1 * v) * v ^ 2 + (-10) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  have hm := (Generated.RankOneZeros.K17.source0 (u + 1 * v) v).mp h'
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hm
  rcases hm with ⟨h1, rfl⟩ | ⟨h1, rfl⟩
  · obtain rfl : u = (-1) := by linarith
    simp
  · obtain rfl : u = 4 := by linarith
    simp

/-- **Irreducible source 1** (several solutions): `RankOneZeros.K17.source1` at `u + 0v`. -/
theorem sols_zirr1 : SolsIn ((-1), 0, (-2), (-6)) [((-1), 0), ((-1), 1), (23, (-26))] := by
  intro u v h
  have h' : -(u + 0 * v) ^ 3 + (-6) * (u + 0 * v) * v ^ 2 + (-6) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  have hm := (Generated.RankOneZeros.K17.source1 (u + 0 * v) v).mp h'
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hm
  rcases hm with ⟨h1, rfl⟩ | ⟨h1, rfl⟩ | ⟨h1, rfl⟩
  · obtain rfl : u = (-1) := by linarith
    simp
  · obtain rfl : u = (-1) := by linarith
    simp
  · obtain rfl : u = 23 := by linarith
    simp

/-- **Irreducible source 2** (several solutions): `RankOneZeros.K17.source2` at `u + 0v`. -/
theorem sols_zirr2 : SolsIn ((-1), 0, (-1), (-8)) [((-1), 0), (3, (-2))] := by
  intro u v h
  have h' : -(u + 0 * v) ^ 3 + (-3) * (u + 0 * v) * v ^ 2 + (-8) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  have hm := (Generated.RankOneZeros.K17.source2 (u + 0 * v) v).mp h'
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hm
  rcases hm with ⟨h1, rfl⟩ | ⟨h1, rfl⟩
  · obtain rfl : u = (-1) := by linarith
    simp
  · obtain rfl : u = 3 := by linarith
    simp

/-- **Irreducible source 0** (witness normalization): `RankOneSources.K17.source0` at `U⁻¹(x, y)`. -/
theorem sols_irr0 : SolsIn ((-2), 0, (-2), (-1)) [(0, (-1))] := by
  intro x y h
  have h' : -(2 * x - (-1) * y) ^ 3 + 12 * (2 * x - (-1) * y) * ((-1) * x + 0 * y) ^ 2 + 18 * ((-1) * x + 0 * y) ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, h2⟩ := (Generated.RankOneSources.K17.source0 _ _).mp h'
  obtain rfl : x = 0 := by linear_combination 0 * h1 + (-1) * h2
  obtain rfl : y = (-1) := by linear_combination 1 * h1 + 2 * h2
  simp

theorem sols_17 : ∀ c ∈ cs_17, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_17, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl
  exacts [sols_irr0, sols_zirr0, sols_zirr1, sols_zirr2, solsIn_of_red (c := ⟨0, 1, (-3), 0, (-17), 0, 1⟩) (by decide +kernel)]

