/-- The 2 classes for `k = 1` with their solution lists. -/
def cs_1 : List ((ℤ × ℤ × ℤ × ℤ) × List (ℤ × ℤ)) := [(((-1), 0, (-1), 0), redSols ⟨1, 0, (-1), 0, (-3), 1, 0⟩), (((-1), 0, 0, (-2)), [((-1), 0), (1, (-1))])]

/-- **Irreducible source 0** (several solutions): `RankOneZeros.K1.source0` at `u + 0v`. -/
theorem sols_zirr0 : SolsIn ((-1), 0, 0, (-2)) [((-1), 0), (1, (-1))] := by
  intro u v h
  have h' : -(u + 0 * v) ^ 3 + 0 * (u + 0 * v) * v ^ 2 + (-2) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  have hm := (Generated.RankOneZeros.K1.source0 (u + 0 * v) v).mp h'
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hm
  rcases hm with ⟨h1, rfl⟩ | ⟨h1, rfl⟩
  · obtain rfl : u = (-1) := by linarith
    simp
  · obtain rfl : u = 1 := by linarith
    simp

theorem sols_1 : ∀ c ∈ cs_1, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_1, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl
  exacts [solsIn_of_red (c := ⟨1, 0, (-1), 0, (-3), 1, 0⟩) (by decide +kernel), sols_zirr0]

