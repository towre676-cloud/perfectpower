/-- **Irreducible source 0** (several solutions): `RankOneZeros.K9.source0` at `u + 0v`. -/
theorem sols_zirr0 : SolsIn ((-1), 0, (-2), (-2)) [((-1), 0), ((-1), 3)] := by
  intro u v h
  have h' : -(u + 0 * v) ^ 3 + (-6) * (u + 0 * v) * v ^ 2 + (-2) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  have hm := (Generated.RankOneZeros.K9.source0 (u + 0 * v) v).mp h'
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hm
  rcases hm with ⟨h1, rfl⟩ | ⟨h1, rfl⟩
  · obtain rfl : u = (-1) := by linarith
    simp
  · obtain rfl : u = (-1) := by linarith
    simp

/-- **Irreducible source 1** (witness normalization): `RankOneSources.K9.source1` at `U⁻¹(x, y)`. -/
theorem sols_irr1 : SolsIn ((-2), (-1), (-2), (-1)) [(0, (-1))] := by
  intro x y h
  have h' : -(2 * x - (-1) * y) ^ 3 + 9 * (2 * x - (-1) * y) * ((-1) * x + 0 * y) ^ 2 + 12 * ((-1) * x + 0 * y) ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, h2⟩ := (Generated.RankOneSources.K9.source1 _ _).mp h'
  obtain rfl : x = 0 := by linear_combination 0 * h1 + (-1) * h2
  obtain rfl : y = (-1) := by linear_combination 1 * h1 + 2 * h2
  simp

/-- **Irreducible source 2** (witness normalization): `RankOneSources.K9.source2` at `U⁻¹(x, y)`. -/
theorem sols_irr2 : SolsIn ((-2), 0, 0, (-3)) [(1, (-1))] := by
  intro x y h
  have h' : -(2 * x - (-3) * y) ^ 3 + 18 * (2 * x - (-3) * y) * ((-1) * x + (-1) * y) ^ 2 + 30 * ((-1) * x + (-1) * y) ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, h2⟩ := (Generated.RankOneSources.K9.source2 _ _).mp h'
  obtain rfl : x = 1 := by linear_combination (-1) * h1 + (-3) * h2
  obtain rfl : y = (-1) := by linear_combination 1 * h1 + 2 * h2
  simp

/-- **Irreducible source 0**: `RankOneSources.K9.source0` at `u + 0v`. -/
theorem sols_irr0 : SolsIn ((-1), 0, 0, (-6)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 0 * v) ^ 3 + 0 * (u + 0 * v) * v ^ 2 + (-6) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K9.source0 (u + 0 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

theorem sols_9 : ∀ c ∈ cs_9, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_9, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl
  exacts [sols_irr1, sols_irr2, sols_zirr0, sols_irr0, solsIn_of_loc (m := 3) (by norm_num) (by decide +kernel)]

