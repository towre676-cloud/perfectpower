/-!
# `y² = x³ + 81` through an irreducible rank-one source, with no premise
(generated by `python/class_list_cert.py rank1`)

The classes for `k = 81` (`positive_k.json`):
* `(-4, -6, -3, -5)` is impossible modulo 9.
* `(-3, 0, -9, 0)` is impossible modulo 3.
* `(-3, 0, 0, -6)` is impossible modulo 3.
* `(-2, 0, 0, -9)` is impossible modulo 7.
* `(-1, 0, 0, -18)`, i.e. `−u³ + (0) u v² + (-18) v³ = 1`, is irreducible; its only solution `(−1, 0)` is `RankOneSources.source81` (unit generation in `ℤ[z]`, `z³ = (0) z + (-18)`, and the 3-adic zero set).
* `(0, -9, -6, -4)` is impossible modulo 7.
* `(0, -3, 0, -81)` is impossible modulo 3.

The class-list premise is proved by `ClassListProof.classList_of` (parameters by `norm_num`,
transports by the kernel), and `PositiveKCurve.complete_of_sols` reads off the points.
-/

set_option Elab.async false

namespace PerfectPower.Generated.ClassLists.K81

open PerfectPower MordellCubicForm ClassListProof PositiveKCurve

/-- The 7 classes for `k = 81` with their solution lists. -/
def cs_81 : List ((ℤ × ℤ × ℤ × ℤ) × List (ℤ × ℤ)) := [(((-4), (-2), (-1), (-5)), []), (((-3), 0, (-3), 0), []), (((-3), 0, 0, (-6)), []), (((-2), 0, 0, (-9)), []), (((-1), 0, 0, (-18)), [((-1), 0)]), ((0, (-3), (-2), (-4)), []), ((0, (-1), 0, (-81)), [])]

/-- **The irreducible source**: `RankOneSources.source81`. -/
theorem sols_irr : SolsIn ((-1), 0, 0, (-18)) [((-1), 0)] := by
  intro u v h
  have h' : -u ^ 3 + 0 * u * v ^ 2 + (-18) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨rfl, rfl⟩ := (Generated.RankOneSources.source81 u v).mp h'
  simp

theorem sols_81 : ∀ c ∈ cs_81, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_81, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  exacts [solsIn_of_loc (m := 9) (by norm_num) (by decide +kernel), solsIn_of_loc (m := 3) (by norm_num) (by decide +kernel), solsIn_of_loc (m := 3) (by norm_num) (by decide +kernel), solsIn_of_loc (m := 7) (by norm_num) (by decide +kernel), sols_irr, solsIn_of_loc (m := 7) (by norm_num) (by decide +kernel), solsIn_of_loc (m := 3) (by norm_num) (by decide +kernel)]

