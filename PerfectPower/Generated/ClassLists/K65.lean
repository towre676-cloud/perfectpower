/-!
# `y² = x³ + 65` through irreducible rank-one sources, with no premise
(generated by `python/class_list_cert.py rank1`)

The classes for `k = 65` (`positive_k.json`):
* `(-2, -6, 0, -5)` is impossible modulo 9.
* `(-2, 0, -6, -7)` is irreducible and nonmonic. Its recorded point `(-1, 1)` gives `U = (1 -3; -1 4)`, `det U = 1`, with `F ∘ U = −u³ + (42) u v² + (-106) v³` (witness normalization); `RankOneSources.K65.source1` proves that form has only `(−1, 0)`, so `F` has only `(-1, 1)`.
* `(-1, 0, -12, -2)` is irreducible with 2 solutions: `F(u, v) = −N((u + 0v) − vz)`, `z³ = (-12) z + (-2)`; the list comes from `RankOneZeros.K65.source0` (unit generation, and a finite zero set by recentred Skolem classes and auxiliary primes).
* `(-1, 0, -3, -16)` is irreducible: `F(u, v) = −N((u + 0v) − vz)` in `ℤ[z]`, `z³ = (-3) z + (-16)`. Its only solution `(−1, 0)` comes from `RankOneSources.K65.source0` (unit generation and the Skolem zero set).
* `(0, -3, 0, -65)` is impossible modulo 9.

The class-list premise is proved by `ClassListProof.classList_of` (parameters by `norm_num`,
transports by the kernel), and `PositiveKCurve.complete_of_sols` reads off the points.
-/

set_option Elab.async false

namespace PerfectPower.Generated.ClassLists.K65

open PerfectPower MordellCubicForm ClassListProof PositiveKCurve ReducibleThue

/-- The 5 classes for `k = 65` with their solution lists. -/
def cs_65 : List ((ℤ × ℤ × ℤ × ℤ) × List (ℤ × ℤ)) := [(((-2), (-2), 0, (-5)), []), (((-2), 0, (-2), (-7)), [((-1), 1)]), (((-1), 0, (-4), (-2)), [((-1), 0), ((-1), 6)]), (((-1), 0, (-1), (-16)), [((-1), 0)]), ((0, (-1), 0, (-65)), [])]

/-- **Irreducible source 0** (several solutions): `RankOneZeros.K65.source0` at `u + 0v`. -/
theorem sols_zirr0 : SolsIn ((-1), 0, (-4), (-2)) [((-1), 0), ((-1), 6)] := by
  intro u v h
  have h' : -(u + 0 * v) ^ 3 + (-12) * (u + 0 * v) * v ^ 2 + (-2) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  have hm := (Generated.RankOneZeros.K65.source0 (u + 0 * v) v).mp h'
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hm
  rcases hm with ⟨h1, rfl⟩ | ⟨h1, rfl⟩
  · obtain rfl : u = (-1) := by linarith
    simp
  · obtain rfl : u = (-1) := by linarith
    simp

/-- **Irreducible source 1** (witness normalization): `RankOneSources.K65.source1` at `U⁻¹(x, y)`. -/
theorem sols_irr1 : SolsIn ((-2), 0, (-2), (-7)) [((-1), 1)] := by
  intro x y h
  have h' : -(4 * x - (-3) * y) ^ 3 + 42 * (4 * x - (-3) * y) * (1 * x + 1 * y) ^ 2 + (-106) * (1 * x + 1 * y) ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, h2⟩ := (Generated.RankOneSources.K65.source1 _ _).mp h'
  obtain rfl : x = (-1) := by linear_combination 1 * h1 + (-3) * h2
  obtain rfl : y = 1 := by linear_combination (-1) * h1 + 4 * h2
  simp

/-- **Irreducible source 0**: `RankOneSources.K65.source0` at `u + 0v`. -/
theorem sols_irr0 : SolsIn ((-1), 0, (-1), (-16)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 0 * v) ^ 3 + (-3) * (u + 0 * v) * v ^ 2 + (-16) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K65.source0 (u + 0 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

theorem sols_65 : ∀ c ∈ cs_65, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_65, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl
  exacts [solsIn_of_loc (m := 9) (by norm_num) (by decide +kernel), sols_irr1, sols_zirr0, sols_irr0, solsIn_of_loc (m := 9) (by norm_num) (by decide +kernel)]

