def cs_100 : List ((ℤ × ℤ × ℤ × ℤ) × List (ℤ × ℤ)) := [(((-4), 0, 0, (-5)), [(1, (-1))]), (((-2), 0, 0, (-10)), []), (((-1), (-2), 1, (-8)), [((-1), 0)]), (((-1), 0, (-4), (-12)), [((-1), 0), ((-1), 1)]), (((-1), 0, 0, (-20)), [((-1), 0), (19, (-7))]), ((0, (-2), (-2), (-14)), []), ((0, (-1), 0, (-100)), redSols ⟨0, 1, (-3), 0, (-100), 0, 1⟩)]

/-- **Irreducible source 0** (several solutions): `RankOneZeros.K100.source0` at `u + 0v`. -/
theorem sols_zirr0 : SolsIn ((-1), 0, (-4), (-12)) [((-1), 0), ((-1), 1)] := by
  intro u v h
  have h' : -(u + 0 * v) ^ 3 + (-12) * (u + 0 * v) * v ^ 2 + (-12) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  have hm := (Generated.RankOneZeros.K100.source0 (u + 0 * v) v).mp h'
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hm
  rcases hm with ⟨h1, rfl⟩ | ⟨h1, rfl⟩
  · obtain rfl : u = (-1) := by linarith
    simp
  · obtain rfl : u = (-1) := by linarith
    simp

/-- **Irreducible source 1** (several solutions): `RankOneZeros.K100.source1` at `u + 0v`. -/
theorem sols_zirr1 : SolsIn ((-1), 0, 0, (-20)) [((-1), 0), (19, (-7))] := by
  intro u v h
  have h' : -(u + 0 * v) ^ 3 + 0 * (u + 0 * v) * v ^ 2 + (-20) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  have hm := (Generated.RankOneZeros.K100.source1 (u + 0 * v) v).mp h'
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hm
  rcases hm with ⟨h1, rfl⟩ | ⟨h1, rfl⟩
  · obtain rfl : u = (-1) := by linarith
    simp
  · obtain rfl : u = 19 := by linarith
    simp

/-- **Irreducible source 1** (witness normalization): `RankOneSources.K100.source1` at `U⁻¹(x, y)`. -/
theorem sols_irr1 : SolsIn ((-4), 0, 0, (-5)) [(1, (-1))] := by
  intro x y h
  have h' : -(4 * x - (-5) * y) ^ 3 + 60 * (4 * x - (-5) * y) * ((-1) * x + (-1) * y) ^ 2 + 180 * ((-1) * x + (-1) * y) ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, h2⟩ := (Generated.RankOneSources.K100.source1 _ _).mp h'
  obtain rfl : x = 1 := by linear_combination (-1) * h1 + (-5) * h2
  obtain rfl : y = (-1) := by linear_combination 1 * h1 + 4 * h2
  simp

/-- **Irreducible source 0**: `RankOneSources.K100.source0` at `u + 2v`. -/
theorem sols_irr0 : SolsIn ((-1), (-2), 1, (-8)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 2 * v) ^ 3 + 15 * (u + 2 * v) * v ^ 2 + (-30) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K100.source0 (u + 2 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

theorem sols_100 : ∀ c ∈ cs_100, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_100, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  exacts [sols_irr1, solsIn_of_loc (m := 2) (by norm_num) (by decide +kernel), sols_irr0, sols_zirr0, sols_zirr1, solsIn_of_loc (m := 2) (by norm_num) (by decide +kernel), solsIn_of_red (c := ⟨0, 1, (-3), 0, (-100), 0, 1⟩) (by decide +kernel)]

