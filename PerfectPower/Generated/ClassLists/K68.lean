  intro u v h
  have h' : -(u + 0 * v) ^ 3 + (-12) * (u + 0 * v) * v ^ 2 + (-4) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  have hm := (Generated.RankOneZeros.K68.source0 (u + 0 * v) v).mp h'
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hm
  rcases hm with ⟨h1, rfl⟩ | ⟨h1, rfl⟩
  · obtain rfl : u = (-1) := by linarith
    simp
  · obtain rfl : u = (-1) := by linarith
    simp

theorem sols_68 : ∀ c ∈ cs_68, SolsIn c.1 c.2 := by
