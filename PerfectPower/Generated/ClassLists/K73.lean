/-- **Irreducible source 0** (several solutions): `RankOneZeros.K73.source0` at `u + 2v`. -/
theorem sols_zirr0 : SolsIn ((-1), (-2), 2, (-6)) [((-7), 1), ((-1), 0)] := by
  intro u v h
  have h' : -(u + 2 * v) ^ 3 + 18 * (u + 2 * v) * v ^ 2 + (-34) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  have hm := (Generated.RankOneZeros.K73.source0 (u + 2 * v) v).mp h'
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hm
  rcases hm with ⟨h1, rfl⟩ | ⟨h1, rfl⟩
  · obtain rfl : u = (-7) := by linarith
    simp
  · obtain rfl : u = (-1) := by linarith
    simp

