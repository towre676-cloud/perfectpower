theorem sols_73 : ∀ c ∈ cs_73, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_73, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl
  exacts [sols_zirr0, sols_irr0, sols_irr1, sols_zirr1, solsIn_of_red (c := ⟨0, 1, (-3), 0, (-73), 0, 1⟩) (by decide +kernel)]

