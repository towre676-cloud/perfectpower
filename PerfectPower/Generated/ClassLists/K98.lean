/-- **Irreducible source 0**: `RankOneSources.K98.source0` at `u + 3v`. -/
theorem sols_irr0 : SolsIn ((-1), (-3), (-2), (-6)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 3 * v) ^ 3 + 21 * (u + 3 * v) * v ^ 2 + (-42) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K98.source0 (u + 3 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

theorem sols_98 : ∀ c ∈ cs_98, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_98, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl
  exacts [solsIn_of_loc (m := 7) (by norm_num) (by decide +kernel), solsIn_of_loc (m := 7) (by norm_num) (by decide +kernel), solsIn_of_red (c := ⟨1, 2, (-2), 4, (-5), 1, 0⟩) (by decide +kernel), sols_irr0, solsIn_of_red (c := ⟨0, 1, (-3), 0, (-98), 0, 1⟩) (by decide +kernel)]

