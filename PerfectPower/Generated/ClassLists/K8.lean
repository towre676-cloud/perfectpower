/-- **Irreducible source 0** (several solutions): `RankOneZeros.K8.source0` at `u + 1v`. -/
theorem sols_zirr0 : SolsIn ((-1), (-1), 1, (-3)) [((-4), 1), ((-1), 0)] := by
  intro u v h
  have h' : -(u + 1 * v) ^ 3 + 6 * (u + 1 * v) * v ^ 2 + (-8) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  have hm := (Generated.RankOneZeros.K8.source0 (u + 1 * v) v).mp h'
  simp only [List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq] at hm
  rcases hm with ⟨h1, rfl⟩ | ⟨h1, rfl⟩
  · obtain rfl : u = (-4) := by linarith
    simp
  · obtain rfl : u = (-1) := by linarith
    simp

/-- **Irreducible source 0**: `RankOneSources.K8.source0` at `u + 1v`. -/
theorem sols_irr0 : SolsIn ((-1), (-1), 0, (-4)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 1 * v) ^ 3 + 3 * (u + 1 * v) * v ^ 2 + (-6) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K8.source0 (u + 1 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

theorem sols_8 : ∀ c ∈ cs_8, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_8, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl
  exacts [sols_irr0, sols_zirr0, solsIn_of_red (c := ⟨1, 0, (-1), 0, (-6), 1, 0⟩) (by decide +kernel), solsIn_of_red (c := ⟨0, 1, (-3), 0, (-8), 0, 1⟩) (by decide +kernel)]

