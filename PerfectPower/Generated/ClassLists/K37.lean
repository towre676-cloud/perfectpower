theorem sols_irr2 : SolsIn ((-2), (-1), (-2), 3) [((-2), (-5))] := by
  intro x y h
  have h' : -(78 * x - 31 * y) ^ 3 + 729 * (78 * x - 31 * y) * ((-5) * x + 2 * y) ^ 2 + 7576 * ((-5) * x + 2 * y) ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, h2⟩ := (Generated.RankOneSources.K37.source2 _ _).mp h'
  obtain rfl : x = (-2) := by linear_combination 2 * h1 + 31 * h2
  obtain rfl : y = (-5) := by linear_combination 5 * h1 + 78 * h2
  simp

/-- **Irreducible source 0**: `RankOneSources.K37.source0` at `u + 1v`. -/
theorem sols_irr0 : SolsIn ((-1), (-1), 2, (-8)) [((-1), 0)] := by
