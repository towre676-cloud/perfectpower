  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K37.source1 (u + 0 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

theorem sols_37 : ∀ c ∈ cs_37, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_37, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl
  exacts [sols_irr2, sols_irr0, sols_irr1, solsIn_of_red (c := ⟨0, 1, (-6), (-3), (-5), 0, 1⟩) (by decide +kernel), solsIn_of_red (c := ⟨0, 1, (-3), 0, (-37), 0, 1⟩) (by decide +kernel)]

