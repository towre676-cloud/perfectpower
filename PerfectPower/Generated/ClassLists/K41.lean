/-!
# `y² = x³ + 41` through irreducible rank-one sources, with no premise
(generated by `python/class_list_cert.py rank1`)

The classes for `k = 41` (`positive_k.json`):
* `(-3, -3, -3, -5)` is impossible modulo 9.
* `(-2, -3, 6, -5)` is impossible modulo 9.
* `(-2, 0, -6, -5)` is impossible modulo 9.
* `(-1, -3, 3, -9)` is irreducible: `F(u, v) = −N((u + 1v) − vz)` in `ℤ[z]`, `z³ = (6) z + (-14)`. Its only solution `(−1, 0)` comes from `RankOneSources.K41.source0` (unit generation and the Skolem zero set).
* `(0, -3, 0, -41)` is reducible, solved by `ReducibleThue` (factor, Bezout pair, integer square root).

The class-list premise is proved by `ClassListProof.classList_of` (parameters by `norm_num`,
transports by the kernel), and `PositiveKCurve.complete_of_sols` reads off the points.
-/

set_option Elab.async false

namespace PerfectPower.Generated.ClassLists.K41

open PerfectPower MordellCubicForm ClassListProof PositiveKCurve ReducibleThue

/-- The 5 classes for `k = 41` with their solution lists. -/
def cs_41 : List ((ℤ × ℤ × ℤ × ℤ) × List (ℤ × ℤ)) := [(((-3), (-1), (-1), (-5)), []), (((-2), (-1), 2, (-5)), []), (((-2), 0, (-2), (-5)), []), (((-1), (-1), 1, (-9)), [((-1), 0)]), ((0, (-1), 0, (-41)), redSols ⟨0, 1, (-3), 0, (-41), 0, 1⟩)]

/-- **Irreducible source 0**: `RankOneSources.K41.source0` at `u + 1v`. -/
theorem sols_irr0 : SolsIn ((-1), (-1), 1, (-9)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 1 * v) ^ 3 + 6 * (u + 1 * v) * v ^ 2 + (-14) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K41.source0 (u + 1 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

theorem sols_41 : ∀ c ∈ cs_41, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_41, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl
  exacts [solsIn_of_loc (m := 9) (by norm_num) (by decide +kernel), solsIn_of_loc (m := 9) (by norm_num) (by decide +kernel), solsIn_of_loc (m := 9) (by norm_num) (by decide +kernel), sols_irr0, solsIn_of_red (c := ⟨0, 1, (-3), 0, (-41), 0, 1⟩) (by decide +kernel)]

