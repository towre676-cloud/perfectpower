/-- **Irreducible source 0** (witness normalization): `RankOneSources.K18.source0` at `U⁻¹(x, y)`. -/
theorem sols_irr0 : SolsIn ((-2), 0, (-1), (-4)) [((-1), 1)] := by
  intro x y h
  have h' : -(3 * x - (-2) * y) ^ 3 + 21 * (3 * x - (-2) * y) * (1 * x + 1 * y) ^ 2 + (-38) * (1 * x + 1 * y) ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, h2⟩ := (Generated.RankOneSources.K18.source0 _ _).mp h'
  obtain rfl : x = (-1) := by linear_combination 1 * h1 + (-2) * h2
  obtain rfl : y = 1 := by linear_combination (-1) * h1 + 3 * h2
  simp

theorem sols_18 : ∀ c ∈ cs_18, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_18, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl
  exacts [sols_irr0, solsIn_of_loc (m := 3) (by norm_num) (by decide +kernel)]

