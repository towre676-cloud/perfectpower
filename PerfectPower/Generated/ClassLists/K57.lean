theorem sols_irr0 : SolsIn ((-1), (-3), (-2), (-4)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 3 * v) ^ 3 + 21 * (u + 3 * v) * v ^ 2 + (-40) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K57.source0 (u + 3 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
