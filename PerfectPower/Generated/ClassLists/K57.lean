theorem sols_57 : ∀ c ∈ cs_57, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_57, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl
