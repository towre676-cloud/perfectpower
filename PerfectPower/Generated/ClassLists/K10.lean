/-- The 2 classes for `k = 10` with their solution lists. -/
def cs_10 : List ((ℤ × ℤ × ℤ × ℤ) × List (ℤ × ℤ)) := [(((-1), 0, (-1), (-6)), [((-1), 0)]), ((0, (-1), 0, (-10)), redSols ⟨0, 1, (-3), 0, (-10), 0, 1⟩)]

/-- **Irreducible source 0**: `RankOneSources.K10.source0` at `u + 0v`. -/
theorem sols_irr0 : SolsIn ((-1), 0, (-1), (-6)) [((-1), 0)] := by
  intro u v h
  have h' : -(u + 0 * v) ^ 3 + (-3) * (u + 0 * v) * v ^ 2 + (-6) * v ^ 3 = 1 := by
    simp only [ev] at h; linear_combination h
  obtain ⟨h1, rfl⟩ := (Generated.RankOneSources.K10.source0 (u + 0 * v) v).mp h'
  obtain rfl : u = -1 := by linarith
  simp

theorem sols_10 : ∀ c ∈ cs_10, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_10, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl
  exacts [sols_irr0, solsIn_of_red (c := ⟨0, 1, (-3), 0, (-10), 0, 1⟩) (by decide +kernel)]

