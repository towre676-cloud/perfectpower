import PerfectPower.RankOneNorm

/-!
# `y² = x³ + 11`: the nonmonic class `(-2, 0, -3, -3)` has no solution (generated by `python/rank_one_norm.py`)

`F(u, v) = 1` gives `w = (-2u + 0v, −v, 0)` of norm `4` in `ℤ[z]`, `z³ = (-6) z + (12)`
(monic reduction). Every element of norm `±4` is `γ ηⁿ` with `γ` in the slab list, and no
`γ ηⁿ` has `z²` coordinate `0` modulo 19 (`RankOneNorm.no_corner_zero`).
-/

set_option Elab.async false

namespace PerfectPower.Generated.RankOneNorm.K11

open PerfectPower UnitBox UnitPremises RankOne RankOneNorm

/-- The fundamental unit of `ℤ[z]`. -/
def η : Z3 := (9337, 1682, 1144)

/-- `η⁻¹`. -/
def ε : Z3 := ((-23), (-2), 12)

/-- The norm-`4` certificate. -/
def c : Cert := ⟨(735139259 / 500000000 : ℚ), (1470278519 / 1000000000 : ℚ), (45279 / 62500 : ℚ), 1144⟩

/-- The representatives of norm `±4` that the slab cannot certify small. -/
def L : List Z3 := [((-16), (-3), (-2)), (16, 3, 2)]

theorem h1 : mul (-6) 12 η ε = (1, 0, 0) := by decide
theorem h2 : mul (-6) 12 ε η = (1, 0, 0) := by decide
theorem n1 : nrm (-6) 12 η = 1 := by decide
theorem n2 : nrm (-6) 12 ε = 1 := by decide
theorem cond : condNB (-6) 12 η c 4 (2 : ℚ) = true := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem slab : slabNB (-6) 12 c 4 (2 : ℚ) L = true := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem orbits : L.all (fun γ => orbitB (-6) 12 γ η 19 18 && orbitB (-6) 12 γ ε 19 18) = true := by
  decide +kernel

/-- **`-2u³ + (0)u²v + (-3)uv² + (-3)v³ = 1` has no integer solution.** -/
theorem empty (u v : ℤ) : (-2) * u ^ 3 + 0 * u ^ 2 * v + (-3) * u * v ^ 2 + (-3) * v ^ 3 ≠ 1 := by
  intro hF
  have hw : nrm (-6) 12 ((-2) * u + 0 * v, -v, 0) = (4 : ℕ) := by
    simp only [nrm]; push_cast; linear_combination (-2 : ℤ) ^ 2 * hF
  exact no_corner_zero h1 h2 n1 n2 cond slab (by norm_num) orbits _ (Or.inl hw) rfl

end PerfectPower.Generated.RankOneNorm.K11
