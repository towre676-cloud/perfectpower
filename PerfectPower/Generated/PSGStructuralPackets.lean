theorem source_reduction (x L T Y : ℚ) : source x L T Y = A x L T Y + T*B x L T Y + (T^2-D x L T Y)*C x L T Y := by
  dsimp [source,A,B,C,D]
  ring

theorem recovered_norm (x L T Y : ℚ) : norm x L T Y = (A x L T Y)^2-D x L T Y*(B x L T Y)^2 := by
  dsimp [norm,A,B,D]
  ring

theorem original_source_sound (x L T Y : ℚ) (hp : source x L T Y=0) (ht : T^2-D x L T Y=0) : norm x L T Y=0 := by
  rw [source_reduction] at hp
  rw [recovered_norm]
  exact PSGStructural.quadratic_elimination_sound _ _ _ _ _ hp ht

