import PerfectPower.RankOneZeros

/-!
# Rank-one sources with several solutions for `k = 1` (generated by `python/rank_one_zeros.py`)

Each source `F(u, v) = −N((u + hv) − vz)` in `ℤ[z]`, `z³ = Pz + Q`, gets
`−u³ + P u v² + Q v³ = 1 ↔ (u, v) ∈ L` from `RankOneZeros.source_list`:
* **Units.** Unit generation is as in `RankOne` (the certificate `condB` and the slab check).
* **Zero set.** The zeros of the `z²` coordinate of `ηⁿ` lie below an explicit bound in each
  direction (`SkolemZeros.corner_zeros2`: a Skolem prime, recentring at known roots, auxiliary
  primes), and one kernel check filters the candidates.
-/

set_option Elab.async false

namespace PerfectPower.Generated.RankOneZeros.K1

open PerfectPower UnitBox UnitPremises RankOne RankOneZeros

/-! ### Source 0: `F = (-1, 0, 0, -2)`, `z³ = (0) z + (-2)`, shift `h = 0` -/

/-- The fundamental unit `η` (`σ(η) > 1`) of source 0. -/
def η0 : Z3 := (1, (-1), 1)

/-- `ε = η⁻¹` for source 0. -/
def ε0 : Z3 := ((-1), (-1), 0)

/-- The rank-one certificate for source 0. -/
def c0 : Cert := ⟨(-25198421 / 20000000 : ℚ), (-1259921049 / 1000000000 : ℚ), (114561 / 125000 : ℚ), 1⟩

theorem h1_0 : mul 0 (-2) η0 ε0 = (1, 0, 0) := by decide

theorem h2_0 : mul 0 (-2) ε0 η0 = (1, 0, 0) := by decide

theorem n1_0 : nrm 0 (-2) η0 = 1 := by decide

theorem n2_0 : nrm 0 (-2) ε0 = 1 := by decide

theorem cond_0 : condB 0 (-2) η0 c0 = true := by decide +kernel

theorem slab_0 : slabB 0 (-2) η0 c0 = true := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem zη_0 : skolemZB2 0 (-2) η0 ε0 3 3 [] 6 = true := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem zε_0 : skolemZB2 0 (-2) ε0 η0 3 3 [] 6 = true := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem list_0 : listB 0 (-2) η0 ε0 3 3 [((-1), 0), (1, (-1))] = true := by decide +kernel

/-- **Source 0**: `−u³ + (0) u v² + (-2) v³ = 1 ↔ (u, v) ∈ [((-1), 0), (1, (-1))]`. -/
theorem source0 (u v : ℤ) : -u ^ 3 + 0 * u * v ^ 2 + (-2) * v ^ 3 = 1 ↔ (u, v) ∈ ([((-1), 0), (1, (-1))] : List (ℤ × ℤ)) :=
  haveI : Fact (Nat.Prime 3) := ⟨by norm_num⟩
  source_list h1_0 h2_0 n1_0 n2_0 cond_0 slab_0 (zeros2_of h1_0 (by norm_num) zη_0)
    (zeros2_of h2_0 (by norm_num) zε_0) list_0 u v

end PerfectPower.Generated.RankOneZeros.K1
