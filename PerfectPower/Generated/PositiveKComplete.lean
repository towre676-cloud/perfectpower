import PerfectPower.PositiveKCurve

/-!
# Positive `k`: complete lists for `y² = x³ + k` without Matveev, under the class-list premise
(generated by `python/positive_k.py`)

For each curve, every class of forms `(a, 3b, 3c, d)` with `Δ = 4k` (stored as `(a, b, c, d)`) is
either locally impossible for the value 1 (`PositiveKCurve.solsIn_of_loc`) or reducible, with all
its solutions from a factorization certificate (`PositiveKCurve.solsIn_of_red`).  The points are
read off by the Hessian covariant (`PositiveKCurve.complete_of_sols`).  The premise `ClassList k`
is **not proved in Lean** (`MORDELL_BRANCH.md` §7.4).
-/

namespace PerfectPower.Generated.PositiveKComplete

open PerfectPower MordellCubicForm ReducibleThue PositiveKCurve

/-- The 2 class(es) for `k = 5` with their solution lists. -/
def cs_5 : List ((ℤ × ℤ × ℤ × ℤ) × List (ℤ × ℤ)) := [(((-1), 0, (-1), (-4)), redSols ⟨1, 1, (-1), 1, (-4), 0, 1⟩), ((0, (-1), 0, (-5)), redSols ⟨0, 1, (-3), 0, (-5), 0, 1⟩)]

theorem sols_5 : ∀ c ∈ cs_5, SolsIn c.1 c.2 := by
  intro c hc
  simp only [cs_5, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl
  exacts [solsIn_of_red (c := ⟨1, 1, (-1), 1, (-4), 0, 1⟩) (by decide +kernel), solsIn_of_red (c := ⟨0, 1, (-3), 0, (-5), 0, 1⟩) (by decide +kernel)]

/-- **`y² = x³ + 5`: the integral points are exactly [((-1), (-2)), ((-1), 2)]**, under the class-list premise. -/
theorem plus5_complete (hcls : ClassList 5 (cs_5.map Prod.fst)) (x y : ℤ) :
    y ^ 2 = x ^ 3 + 5 ↔ (x, y) ∈ ([((-1), (-2)), ((-1), 2)] : List (ℤ × ℤ)) :=
  complete_of_sols hcls sols_5 (by decide +kernel) x y

