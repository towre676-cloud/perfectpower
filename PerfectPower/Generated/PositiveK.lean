/-- The 2 class(es) for `k = 6`, each with a residue modulus. -/
def cs_6 : List ((ℤ × ℤ × ℤ × ℤ) × ℕ) := [(((-2), (-1), 0, (-2)), 9), ((0, (-1), 0, (-6)), 3)]

theorem cert_6 : emptyCertB 6 cs_6 = true := by decide +kernel

/-- **`y² = x³ + 6` has no integral point**, under the class-list premise. -/
theorem plus6 (hcls : ClassList 6 (cs_6.map Prod.fst)) (x y : ℤ) : y ^ 2 ≠ x ^ 3 + 6 :=
  no_point_of_cert hcls cert_6 x y

